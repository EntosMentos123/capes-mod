{
  "schemaVersion": 1,
  "id": "lunarcapes",
  "version": "${version}",
  "name": "Lunar Capes",
  "description": "See Lunar Client capes on vanilla Fabric without needing Lunar Client — 26.3 only.",
  "authors": [
    "LunarCapes"
  ],
  "contact": {
    "homepage": "https://github.com/EntosMentos123/capes-mod",
    "sources": "https://github.com/EntosMentos123/capes-mod",
    "issues": "https://github.com/EntosMentos123/capes-mod/issues"
  },
  "license": "MIT",
  "icon": "assets/lunarcapes/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "me.lunarcapes.LunarCapesMod"
    ]
  },
  "mixins": [
    "lunarcapes.mixins.json",
    {
      "config": "lunarcapes.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.github_releases": "https://github.com/EntosMentos123/capes-mod/releases"
      }
    }
  }
}
